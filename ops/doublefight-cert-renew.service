[Unit]
Description=Renew DoubleFight short-lived IP certificate and check expiry
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --quiet --no-random-sleep-on-renew
ExecStartPost=/usr/bin/openssl x509 -in /etc/letsencrypt/live/150.158.127.128/fullchain.pem -noout -checkend 172800
TimeoutStartSec=15min
