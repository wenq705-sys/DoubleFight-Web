FROM node:22-alpine

WORKDIR /app

COPY package.json ./
RUN npm install --no-audit --no-fund
RUN mkdir /data && chown node:node /data

COPY tsconfig.server.json ./
COPY server ./server
COPY shared ./shared

ENV HOST=0.0.0.0
ENV PORT=8787
EXPOSE 8787

USER node
ENV DOUBLEFIGHT_DATA_DIR=/data
CMD ["node", "--import", "tsx", "server/index.ts"]
