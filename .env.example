# Browser client: public websocket endpoint used by Online Duel.
# Production should use wss:// behind TLS, e.g. wss://game.example.com/ws
VITE_WS_URL=

# Game server
HOST=0.0.0.0
PORT=8787

# Server-only Douyin account settings. Fill outside Git; never put real values here.
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUBLEFIGHT_SESSION_SECRET=
# Optional previous key during rotation; remove after all old sessions expire.
DOUBLEFIGHT_SESSION_SECRET_PREVIOUS=
# Optional for local server; production compose uses a persistent /data volume.
DOUBLEFIGHT_DATA_DIR=
