{
  "name": "doublefight-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "build:douyin": "node scripts/build-douyin.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false && tsc -p tsconfig.douyin.json --noEmit --pretty false"
  },
  "dependencies": {
    "three": "0.179.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.179.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
